# Copy to .env.local for local development. Never commit real values.

# --- Site -------------------------------------------------------------------
# Canonical production URL (no trailing slash). Used for metadata, canonical
# links, sitemap.xml, robots.txt and structured data.
NEXT_PUBLIC_SITE_URL=https://futurizetechnology.com

# --- Public contact details (shown on the site only when set) --------------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_LOCATION=

# --- Social profiles (footer icons appear only for the ones you set) --------
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_GITHUB=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# --- Contact form email delivery (server-side only) -------------------------
# RESEND_API_KEY is required for the contact form to send. Without it the API
# returns a clear "not configured" error instead of a fake success.
RESEND_API_KEY=
# Where inquiries arrive. Defaults to bekerberiso@gmail.com when left empty.
CONTACT_EMAIL=
# Sender. Leave empty to use Resend's test sender (onboarding@resend.dev), which
# only delivers to the email you signed up to Resend with. After verifying your
# domain in Resend, set e.g. "Futurize Technology <hello@futurizetechnology.com>"
EMAIL_FROM=

# --- Newsletter (optional) ---------------------------------------------------
# Set NEXT_PUBLIC_NEWSLETTER_ENABLED=true to show the signup form on /blog.
# Signups are stored in a Resend Audience.
NEXT_PUBLIC_NEWSLETTER_ENABLED=false
RESEND_AUDIENCE_ID=

# --- Rate limiting (optional, defaults shown) --------------------------------
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=600000
